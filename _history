ats][] = [\n        [392, music.beat(BeatFraction.Quarter)], // G\n        [330, music.beat(BeatFraction.Quarter)], // E\n        [262, music.beat(BeatFraction.Quarter)], // C\n        [330, music.beat(BeatFraction.Quarter)], // E\n        [392, music.beat(BeatFraction.Quarter)], // G\n        [523, music.beat(BeatFraction.Quarter)], // C5\n        [659, music.beat(BeatFraction.Half)],    // E5\n        [622, music.beat(BeatFraction.Quarter)], // D#5\n        [587, music.beat(BeatFraction.Quarter)], // D5\n        [523, music.beat(BeatFraction.Quarter)], // C5\n        [440, music.beat(BeatFraction.Quarter)], // A4\n        [440, music.beat(BeatFraction.Quarter)], // A4\n        [494, music.beat(BeatFraction.Quarter)], // B4\n        [523, music.beat(BeatFraction.Half)]     // C5\n        // You can continue adding the rest of the song notes here\n    ]\n"]]},{"start1":1640,"length1":356,"diffs":[[1,"    // Play the melody\n    for (let i = 0; i < melody.length; i++) {\n        playNote(melody[i][0], melody[i][1])\n    }\n"]]},{"start1":1761,"length1":102,"diffs":[[1,"    // Optional: Simple LED party effect while song is playing\n    for (let i = 0; i < 10; i++) {\n        basic.showLeds(`\n            ${i % 2 == 0 ? '. # . # .' : '# . # . #'}\n            ${i % 2 == 0 ? '# . # . #' : '. # . # .'}\n            . . # . .\n            . # . # .\n            # . . . #\n        `)\n        basic.pause(200)\n    }\n\n    basic.showString(\"Done!\")\n})"]]}]}]},{"timestamp":1761149377864,"editorVersion":"8.0.17","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":84,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"23\" y=\"7\"><statement name=\"HANDLER\"><block type=\"music_playable_play\"><field name=\"playbackMode\">music.PlaybackMode.UntilDone</field><value name=\"toPlay\"><shadow type=\"music_tone_playable\"><value name=\"note\"><shadow type=\"device_note\"><field name=\"name\">262</field></shadow></value><value name=\"duration\"><shadow type=\"device_beat\"><field name=\"fraction\">BeatFraction.Whole</field></shadow></value></shadow><block type=\"music_tone_playable\"><value name=\"note\"><shadow type=\"device_note\"><field name=\"name\">440</field></shadow></value><value name=\"duration\"><shadow type=\"device_beat\"><field name=\"fraction\">BeatFraction.Whole</field></shadow></value></block></value></block></statement></block></xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":0,"diffs":[[1,"# MicroPython code for BBC Micro: bit\n# Play a simplified version of \"Sleigh Ride\" using play_tone\n"]]},{"start1":100,"length1":0,"diffs":[[1,"from microbit import sleep, pin0\n\n# Define notes(frequencies in Hz)\nC4 = 262\nD4 = 294\nE4 = 330\nF4 = 349\nG4 = 392\nA4 = 440\nB4 = 494\nC5 = 523\nD5 = 587\n\n# Define a simple sleigh ride melody as (frequency, duration in ms)\n# This is an illustrative simplified version\nmelody = [\n    (E4, 250), (E4, 250), (F4, 250), (G4, 250),\n    (G4, 250), (F4, 250), (E4, 250), (D4, 250),\n    (C4, 250), (C4, 250), (D4, 250), (E4, 250),\n    (E4, 375), (D4, 125), (D4, 500),\n\n    (E4, 250), (E4, 250), (F4, 250), (G4, 250),\n    (G4, 250), (F4, 250), (E4, 250), (D4, 250),\n    (C4, 250), (C4, 250), (D4, 250), (E4, 250),\n    (D4, 375), (C4, 125), (C4, 500)\n]\n\n# Function to play the melody on pin0\ndef play_melody(melody):\nfor note, duration in melody:\n    if note == 0:\n            # Pause for a rest\n            sleep(duration)\n        else:\npin0.write_analog(512)  # activate pin\npin0.set_analog_period(int(1000000 / note))\nsleep(duration)\npin0.write_analog(0)  # stop tone\nsleep(50)  # short pause between notes\n\n# Play the melody\nwhile True:\n    play_melody(melody)\nsleep(1000)  # 1 - second pause before repeating"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":250,"length1":75,"diffs":[[1,"    \"preferredEditor\": \"tsprj\"\n"]]}]